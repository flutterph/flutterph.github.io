# Nothing is required to run the site locally. Every variable is optional.

# Include entries marked `sample: true` in content/. Defaults to true in
# `pnpm dev` and false in `pnpm build`. `pnpm build:preview` sets it to true.
SHOW_SAMPLE_CONTENT=

# Canonical origin used for metadata, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://flutter.ph

# Analytics provider. Empty means disabled (always disabled in development).
# Decided in Phase 5.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
