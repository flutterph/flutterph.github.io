{
  "name": "flutter-ph-website",
  "version": "0.1.0",
  "private": true,
  "description": "Flutter Philippines community website (flutter.ph)",
  "license": "BSD-3-Clause",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && next-image-export-optimizer",
    "build:preview": "SHOW_SAMPLE_CONTENT=true pnpm build",
    "start": "serve out --listen 3000 --no-clipboard",
    "content:build": "content-collections build",
    "content:clear-samples": "node scripts/clear-samples.mjs",
    "typecheck": "pnpm content:build && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "analyze": "ANALYZE=true next build --webpack",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build:preview && pnpm test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "minisearch": "7.2.0",
    "next": "16.4.6",
    "next-image-export-optimizer": "1.21.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@content-collections/cli": "^0.1.9",
    "@content-collections/core": "0.15.3",
    "@content-collections/mdx": "0.2.2",
    "@content-collections/next": "0.2.11",
    "@lhci/cli": "0.16.1",
    "@next/bundle-analyzer": "16.4.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.8",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
